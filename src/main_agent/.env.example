# Copy this file to ".env" in the same folder for local runs.
# NEVER commit the real .env — it's already in .gitignore.

# --- Gemini / Google ADK ---
GOOGLE_API_KEY=your_gemini_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# --- Databricks (only needed if you run deploy/deploy_to_databricks.py locally) ---
DATABRICKS_HOST=https://adb-xxxxxxxxxxxxxxxx.xx.azuredatabricks.net
DATABRICKS_TOKEN=dapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Unity Catalog / serving endpoint naming ---
UC_CATALOG=main
UC_SCHEMA=agents
UC_MODEL_NAME=mini_weather_agent
ENDPOINT_NAME=mini-weather-agent-endpoint
